# Copy to .env.local and fill in. Only VITE_* variables reach the browser — never put secrets here.

# Routing: "browser" (clean /t/slug URLs; host must serve index.html for unknown paths) or "hash" (/#/t/slug; works anywhere).
VITE_ROUTER=browser

# Sub-path the app is served from when not at the domain root, e.g. /smashboard/ (browser routing only).
# VITE_BASE_PATH=/

# Public origin used in QR codes and share links. Defaults to the current origin.
# VITE_SITE_URL=https://smashboard.example.com

# Supabase project (Project Settings → API). The anon key is public by design; RLS protects data.
# Never put the service_role key in any VITE_ variable.
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Show "Continue with Google". Enable the Google provider in Supabase (Authentication → Providers) first.
# VITE_AUTH_GOOGLE=true
